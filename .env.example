# Where the SQLite database and uploaded job photos live.
# Defaults to ./data/detailflow.db — set this to a path on a persistent
# volume when deploying (e.g. /data/detailflow.db).
DATABASE_PATH=./data/detailflow.db

# --- Customer messaging (optional) ------------------------------------------
# Without these the app still queues every message and shows it in the message
# log; it just cannot deliver. Add a key and the queue drains automatically.

# Email — https://resend.com, free tier covers a small shop
# RESEND_API_KEY=re_...

# SMS — https://46elks.com (Swedish) or Twilio. Set one pair, not both.
# ELKS_API_USERNAME=
# ELKS_API_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Card payments (optional) ------------------------------------------------
# Without these the booking site asks customers to pay on the day.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook: point Stripe at /api/stripe/webhook for checkout.session.completed
# STRIPE_WEBHOOK_SECRET=whsec_...
